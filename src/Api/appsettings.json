{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=igf_academic_repo;Username=postgres;Password=postgres",
    "Redis": "localhost:6379"
  },
  "Jwt": {
