{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=igf_academic_repo;Username=postgres;Password=postgres",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Issuer": "IgfAcademicRepo",
    "Audience": "IgfAcademicRepoClient",
    "SecretKey": "SuperSecretKeyForDevelopmentTesting1234567890!",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "LocalStorage": {
    "StoragePath": "uploads",
    "BaseUrl": "http://localhost:5000/uploads"
  },
  "S3Storage": {
    "ServiceUrl": "",
    "BucketName": "igf-academic-materials",
    "AccessKey": "",
    "SecretKey": "",
    "UsePublicUrl": true,
    "PublicBaseUrl": "https://pub-r2.example.com"
  },
  "Email": {
    "Host": "localhost",
    "Port": 587,
    "Username": "",
    "Password": "",
    "SenderEmail": "noreply@isutic.ed.ao",
    "SenderName": "Repositório Académico IGF",
    "AdminEmail": "admin@isutic.ed.ao",
    "EnableSsl": false,
    "UseMock": true
  },
  "RateLimiting": {
    "GeneralPermitLimit": 100,
    "GeneralWindowSeconds": 60,
    "StrictPermitLimit": 10,
    "StrictWindowSeconds": 60
  }
}
